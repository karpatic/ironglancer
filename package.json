{
  "name": "ironglancer",
  "version": "0.2.5",
  "description": "Analyze browser-side JavaScript/JSX front-end architecture from HTML or module entries.",
  "type": "module",
  "author": "Carlos Karpati",
  "license": "MIT",
  "homepage": "https://karpatic.github.io/ironglancer/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karpatic/ironglancer.git"
  },
  "bugs": {
    "url": "https://github.com/karpatic/ironglancer/issues"
  },
  "keywords": [
    "frontend",
    "browser",
    "react",
    "architecture",
    "visualization",
    "dependency-graph",
    "webpack",
    "webpack-plugin",
    "mermaid",
    "jsx",
    "javascript",
    "cli",
    "static-site"
  ],
  "bin": {
    "ironglancer": "src/cli.mjs",
    "ironglancer-agent": "src/agent-cli.mjs"
  },
  "exports": {
    ".": "./src/index.js",
    "./analyze-project": "./src/lib/analyze-project.js",
    "./diff": "./src/lib/diff-snapshots.js",
    "./generate-static-site": "./src/lib/generate-static-site.js",
    "./serve-static-site": "./src/lib/serve-static-site.js",
    "./webpack": {
      "import": "./src/webpack-plugin.js",
      "require": "./src/webpack-plugin.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "dist/action/",
    "action.yml",
    "README.md",
    "CHANGELOG.md",
    "MIGRATION.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "build:action": "node ./scripts/build-action.mjs",
    "check:action-bundle": "node ./scripts/build-action.mjs --check",
    "build:demo": "node ./scripts/build-demo.mjs",
    "release:check": "node ./scripts/release-check.mjs",
    "prepublishOnly": "npm test",
    "publish:npm": "npm publish --access public",
    "publish:github": "./scripts/publish-github-package.sh",
    "publish:all": "npm run publish:npm && npm run publish:github"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@babel/parser": "^7.29.8",
    "mermaid": "^11.12.0"
  },
  "peerDependencies": {
    "webpack": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "webpack": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vercel/ncc": "^0.38.4",
    "bundlessdev": "1.0.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "webpack": "^5.109.2"
  }
}
